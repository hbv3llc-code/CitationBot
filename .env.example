# PostgreSQL database
DATABASE_URL=postgresql://citationbot:password@localhost:5432/citationbot

# NextAuth
NEXTAUTH_SECRET=your-32-char-random-secret-here
NEXTAUTH_URL=http://localhost:3000

# Anthropic Claude API (for AI descriptions + auto-repair)
ANTHROPIC_API_KEY=your-anthropic-api-key

# Google OAuth (for Gmail read-only access)
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# Encryption key for AES-256 password storage (32 bytes hex)
ENCRYPTION_KEY=your-32-byte-hex-encryption-key

# App URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Worker config
WORKER_POLL_INTERVAL_MS=5000
