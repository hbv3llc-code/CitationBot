# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Anthropic Claude API (for AI descriptions + auto-repair)
ANTHROPIC_API_KEY=your-anthropic-api-key

# Google OAuth (for Gmail read-only access)
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# Encryption key for AES-256 password storage (32 bytes hex)
ENCRYPTION_KEY=your-32-byte-hex-encryption-key

# App URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Chrome Extension ID (from chrome://extensions after loading unpacked extension)
NEXT_PUBLIC_CHROME_EXTENSION_ID=

# Worker config
WORKER_CONCURRENCY=1
WORKER_POLL_INTERVAL_MS=5000
